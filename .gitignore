# Design / spec packages — local only, never committed
design-packages/

# Dependencies
# no trailing slash: a bare `node_modules/` matches only a real directory, and
# a worktree links these in rather than installing its own — a symlink is a
# file, so the slashed form would let it be committed
node_modules

# Build output
dist/
storybook-static/
build/
coverage/

# Env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# TS incremental build info
*.tsbuildinfo

#claude
.claude/

# local git worktrees (parallel task branches)
/worktrees/
