# Copy to .env and adjust. .env is gitignored — never commit it.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL 15) ---
# Host-run dev mode (npm run dev) reads this to reach the compose-published
# postgres on localhost. Inside Docker Compose the backend service overrides
# it to the in-network host, so this value is dev-only and must match the
# POSTGRES_PORT value below.
# Credential-free on purpose — no password belongs in a checked-in file. The
# POSTGRES_USER / POSTGRES_PASSWORD values below supply the user and
# password, and the config layer composes them into the connection at read
# time. A DB_URL that already embeds credentials (a real deployment's secret
# URL) is used exactly as given instead.
DB_URL=postgres://localhost:5432/taskdb
# Optional read replica — leave empty to use DB_URL for reads. Follows the
# same credential-free rule as DB_URL above.
DB_READ_URL=
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# --- Redis (realtime fan-out + throttler storage) ---
REDIS_URL=redis://localhost:6379

# --- HTTP ---
# Comma-separated allowlist, never *
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=100

# --- Realtime ---
REALTIME_MAX_CONNECTIONS=1000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_REALTIME_URL=http://localhost:3000/realtime

# --- Docker Compose (postgres container bootstrap) ---
# Local-only bootstrap values. Compose refuses to start if any of them is
# empty. Also the credential source for the host-run backend's DB_URL above.
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskdb
# Host ports — change if 5432 / 6379 are already taken locally
POSTGRES_PORT=5432
REDIS_PORT=6379
