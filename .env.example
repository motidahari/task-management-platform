# Copy to .env and adjust. .env is gitignored — never commit it.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL 15) ---
# Docker Compose assembles DB_URL from the POSTGRES_* values below.
# Only host-run dev mode (npm run dev) needs it set here:
#   DB_URL=postgres://<user>:<password>@localhost:5432/<db>
DB_URL=
# Optional read replica — leave empty to use DB_URL for reads
DB_READ_URL=
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# --- Redis (realtime fan-out + throttler storage) ---
REDIS_URL=redis://localhost:6379

# --- HTTP ---
# Comma-separated allowlist, never *
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=100

# --- Realtime ---
REALTIME_MAX_CONNECTIONS=1000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_REALTIME_URL=http://localhost:3000/realtime

# --- Docker Compose (postgres container bootstrap) ---
# Local-only bootstrap values. Compose refuses to start if any of them is empty.
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskdb
# Host ports — change if 5432 / 6379 are already taken locally
POSTGRES_PORT=5432
REDIS_PORT=6379
